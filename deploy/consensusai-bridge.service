# Photon iMessage bridge. Install: deploy/setup.sh (run as root on the server).
[Unit]
Description=ConsensusAI Photon iMessage bridge
After=network-online.target
Wants=network-online.target

[Service]
User=consensusai
WorkingDirectory=/opt/consensusai/app
EnvironmentFile=/etc/consensusai/bridge.env
ExecStart=/opt/consensusai/venv/bin/python -u photon_bridge.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
