# First-time setup: cp .env.example .env
# Fill in the values for the integrations you use, then load in each terminal:
# set -a; . ./.env; set +a
# Python scripts do not automatically load .env. Keep real keys only in .env.
# Keep values single-quoted so shell characters in keys/URLs stay literal.

# StepFun: natural-language preference parsing (global platform.stepfun.ai key).
STEP_API_KEY=''
# STEPFUN_API_KEY is also accepted as an alternative to STEP_API_KEY.

# Google Places: live restaurant search (enable Places API for this key).
GOOGLE_PLACES_API_KEY=''

# Browser Use: live restaurant availability checks.
BROWSER_USE_API_KEY=''

# Tiger Data / Postgres: paste the complete connection URL, including SSL options.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=''

# Photon iMessage bridge: project ID and pho_sk_ Bearer secret from Photon.
# Both are required to run photon_bridge.py.
PROJECT_ID=''
PROJECT_SECRET=''

# uAgents organizer: choose a private, random seed before starting organizer.py.
ORGANIZER_SEED=''
# Copy the organizer address from its startup logs before starting personal agents.
ORGANIZER_ADDRESS=''

# ASI:One owner sender addresses. Set each to its owner's agent address.
# Multiple addresses may be comma-separated; private negotiation needs one owner.
MAYA_OWNER_ADDRESSES=''
JORDAN_OWNER_ADDRESSES=''
SAM_OWNER_ADDRESSES=''

# Optional local settings. NEGOTIATION_DEMO=1 uses the fixed demo venues.
PLAN_AREA='Westwood, Los Angeles'
NEGOTIATION_DEMO='0'

# Optional test settings: uncomment only when intentionally running live tests.
# TEST_DATABASE_URL='postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE?sslmode=require'
# STEPFUN_LIVE_TEST='1'
# PLACES_LIVE_TEST='1'
